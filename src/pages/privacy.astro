---
import BaseLayout from '../layouts/BaseLayout.astro';
import { SITE_NAME } from '../data/site';
---
<BaseLayout
  title="Privacy"
  description={`${SITE_NAME} privacy: tools run locally in the browser. No accounts. No uploads.`}
  path="/privacy/"
>
  <h1>Privacy</h1>
  <p>Tools run locally in the browser.</p>
  <p>No accounts.</p>
  <p>No file or text uploads to our server.</p>
  <p>v1 loads no analytics and no ad network.</p>
  <p>If ads or analytics are added, this page will be updated.</p>
</BaseLayout>
