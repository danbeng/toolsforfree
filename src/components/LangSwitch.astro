---
import { LOCALES, LOCALE_META, type Locale } from '../i18n/locales';
import { switchLocalePath } from '../i18n/path';
import { stripBase, withBase } from '../i18n/base';
import { t } from '../i18n/ui';

interface Props {
  locale: Locale;
  path?: string;
}

const { locale, path } = Astro.props;
const pathname = path ?? stripBase(Astro.url.pathname);
const copy = t(locale);
---
<nav class="lang-switch" aria-label={copy.langSwitch}>
  {LOCALES.map((loc) => (
    <a
      href={withBase(switchLocalePath(pathname, loc))}
      hreflang={LOCALE_META[loc].hreflang}
      lang={LOCALE_META[loc].htmlLang}
      aria-current={loc === locale ? 'page' : undefined}
    >
      {LOCALE_META[loc].nativeLabel}
    </a>
  ))}
</nav>
