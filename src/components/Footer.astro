---
import { SITE_NAME } from '../data/site';
import type { Locale } from '../i18n/locales';
import { localizedPath } from '../i18n/path';
import { withBase } from '../i18n/base';
import { t } from '../i18n/ui';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const copy = t(locale);
---
<footer class="site">
  <div class="wrap footer-row">
    <p>
      <a href={withBase(localizedPath(locale, '/privacy/'))}>{copy.navPrivacy}</a> ·
      <a href={withBase(localizedPath(locale, '/terms/'))}>{copy.navTerms}</a> ·
      <a href={withBase(localizedPath(locale, '/about/'))}>{copy.navAbout}</a>
    </p>
    <p>{copy.footerRuns}</p>
    <p>© {new Date().getFullYear()} {SITE_NAME}</p>
  </div>
</footer>
